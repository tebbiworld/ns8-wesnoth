# Battle for Wesnoth multiplayer server: one rootless container running
# wesnothd (ghcr.io/tebbiworld/wesnoth-server, built by this module from the
# official source tag and pinned through org.nethserver.images ->
# ${WESNOTH_SERVER_IMAGE}).
#
# Port: wesnothd listens on 15000 inside the container; the port chosen in
# the settings (${GAME_PORT}) is published on all node addresses and opened
# on the node firewall by configure-module.
#
# Config: state/wesnothd.cfg (generated by configure-module, mounted
# read-only). Data volume wesnoth-data (/var/lib/wesnothd): saved replays,
# ban list, the admin command FIFO.

[Unit]
Description=Battle for Wesnoth server
After=network-online.target
Wants=network-online.target

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
WorkingDirectory=%S/state
Restart=always
TimeoutStartSec=120
TimeoutStopSec=60
ExecStartPre=/bin/rm -f %t/wesnoth.pid %t/wesnoth.ctr-id
ExecStart=/usr/bin/podman run \
    --conmon-pidfile %t/wesnoth.pid \
    --cidfile %t/wesnoth.ctr-id \
    --cgroups=no-conmon \
    --replace -d --name wesnoth \
    --stop-timeout 30 \
    --publish ${GAME_PORT}:15000/tcp \
    --volume wesnoth-data:/var/lib/wesnothd:Z \
    --volume %S/state/wesnothd.cfg:/etc/wesnothd/wesnothd.cfg:ro,z \
    ${WESNOTH_SERVER_IMAGE} ${WESNOTHD_LOG_ARGS}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/wesnoth.ctr-id -t 30
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/wesnoth.ctr-id
PIDFile=%t/wesnoth.pid
Type=forking
SyslogIdentifier=%u

[Install]
WantedBy=default.target
