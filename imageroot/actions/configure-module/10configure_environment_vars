# Persist the settings in state/environment (loaded by wesnoth.service) and
# write the server configuration state/wesnothd.cfg (WML, mounted read-only
# into the container). The admin password is stored in the environment so
# that an empty field keeps it.

import json
import os
import re
import subprocess
import sys

import agent
import modsecrets

data = json.load(sys.stdin)
env = os.environ


def wml(value):
    """Quote a string for a WML attribute: quotes are doubled."""
    return '"' + str(value).replace('"', '""') + '"'


def server_series():
    """Stable series of the pinned wesnothd (e.g. 1.18.*), read from the image env."""
    try:
        out = subprocess.run(["podman", "image", "inspect", env["WESNOTH_SERVER_IMAGE"],
                              "--format", "{{range .Config.Env}}{{println .}}{{end}}"],
                             capture_output=True, text=True, timeout=30).stdout
        m = re.search(r"^WESNOTH_VERSION=(\d+)\.(\d+)\.", out, re.M)
        if m:
            return f"{m.group(1)}.{m.group(2)}.*"
    except Exception:
        pass
    return ""


game_port = int(data.get("game_port") or 15000)
password = (data.get("admin_password") or "").strip()
if data.get("admin_password_clear"):
    password = ""
elif not password:
    password = modsecrets.get("ADMIN_PASSWORD")
motd = (data.get("motd") or "").strip()
connections = int(data.get("connections_allowed") if data.get("connections_allowed") is not None else 5)
versions = ",".join(v.strip() for v in (data.get("versions_accepted") or "").split(",") if v.strip())
save_replays = bool(data.get("save_replays", False))
names = [n.strip() for n in (data.get("disallow_names") or []) if n.strip()]
log_level = data.get("log_level") or "info"
log_args = {"warning": "--log-warning=server", "info": "--log-info=server", "debug": "--log-debug=server"}[log_level]

# The admin password is a secret: state/passwords.env, not the module environment.
modsecrets.write({"ADMIN_PASSWORD": password})

agent.mset_env({
    "GAME_PORT": str(game_port),
    "MOTD": motd,
    "CONNECTIONS_ALLOWED": str(connections),
    "VERSIONS_ACCEPTED": versions,
    "SAVE_REPLAYS": "true" if save_replays else "false",
    "DISALLOW_NAMES": ",".join(names),
    "LOG_LEVEL": log_level,
    "WESNOTHD_LOG_ARGS": log_args,
})

effective_versions = versions or server_series()

lines = [
    "# Generated by configure-module. Do not edit by hand.",
    "# wesnothd listens on 15000 inside the container; the node port is ${GAME_PORT}.",
    f"connections_allowed={connections}",
    "max_messages=8",
    "messages_time_period=10",
    "allow_remote_shutdown=no",
    'fifo_path="/var/lib/wesnothd/socket"',
    'ban_save_file="/var/lib/wesnothd/bans.gz"',
    f"save_replays={'yes' if save_replays else 'no'}",
    'replay_save_path="/var/lib/wesnothd/replays/"',
]
if effective_versions:
    lines.append(f"versions_accepted={wml(effective_versions)}")
if motd:
    lines.append(f"motd={wml(motd)}")
if password:
    lines.append(f"passwd={wml(password)}")
if names:
    lines.append(f"disallow_names={wml(','.join(names))}")
# Temporary ban durations selectable with "ban <mask> <name>" in the console
for name, time in (("short", "1h"), ("day", "1D"), ("week", "7D"), ("month", "30D")):
    lines += ["[ban_time]", f"    name={name}", f"    time={time}", "[/ban_time]"]

# world-readable: inside the rootless container wesnothd runs as a mapped uid
# that is not the module user; the state directory itself is private (0700)
with open("wesnothd.cfg.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.chmod("wesnothd.cfg.tmp", 0o644)
os.replace("wesnothd.cfg.tmp", "wesnothd.cfg")
