# Checks beyond the JSON schema: the game port must be free on the node
# (unless it is the port this instance already uses), the password must not
# break the WML config, version patterns must be sane.

import json
import os
import re
import subprocess
import sys

import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
errors = []

def fail(field, value, error):
    errors.append({"field": field, "parameter": field, "value": value, "error": error})

def port_in_use(port):
    out = subprocess.run(["ss", "-tlnH", f"sport = :{port}"], capture_output=True, text=True).stdout
    return bool(out.strip())

game_port = int(data["game_port"])
if game_port != int(os.environ.get("GAME_PORT", 0)) and port_in_use(game_port):
    fail("game_port", game_port, "port_in_use")

if "\n" in (data.get("admin_password") or ""):
    fail("admin_password", "", "invalid_characters")
if "\n" in (data.get("motd") or ""):
    fail("motd", "", "invalid_characters")

versions = (data.get("versions_accepted") or "").strip()
if versions and not all(re.fullmatch(r"[0-9A-Za-z_.*?+-]+", v.strip()) for v in versions.split(",") if v.strip()):
    fail("versions_accepted", versions, "invalid_version_pattern")

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
